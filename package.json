{
  "name": "loopin-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:schema:update": "node scripts/update-openapi-schema.mjs",
    "api:generate": "openapi-typescript contracts/openapi.json -o lib/api/generated/schema.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- contracts/openapi.json lib/api/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "security:check": "npm run lint && npm run typecheck && npm test && npm run security:audit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/leaflet": "^1.9.22",
    "@types/sockjs-client": "^1.5.4",
    "axios": "^1.19.0",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sockjs-client": "^1.6.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
