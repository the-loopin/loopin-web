# Public browser configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:8080/api/ws
# Comma-separated exact hostnames allowed for presigned uploads in production.
NEXT_PUBLIC_MEDIA_UPLOAD_HOSTS=storage.example.com

# Server-only REST API target used by the Next.js BFF proxy.
# Production deployments must use HTTPS.
API_INTERNAL_BASE_URL=http://localhost:8080/api/v1

# Development-only escape hatch. Never enable this in production.
ENABLE_DEV_LOGIN=false
